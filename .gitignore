cat > .gitignore <<'EOF'
# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Mac
.DS_Store
__MACOSX/

# Virtual environments
.venv/
venv/
env/

# Large temporary model files
*.pkl
*.joblib
*.log

# Optional: keep raw data local if needed
# data/raw/*.csv

# Final zip should be created only at the end
final_submission/*.zip
EOF