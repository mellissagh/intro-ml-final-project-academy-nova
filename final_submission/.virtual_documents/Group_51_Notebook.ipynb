def plot_fold_roc_curves(model, X, y, model_name, n_splits=N_SPLITS):
    skf = StratifiedKFold(
        n_splits=n_splits,
        shuffle=True,
        random_state=RANDOM_STATE
    )

    plt.figure(figsize=(8, 6))
    fold_auc_rows = []

    for fold, (train_idx, valid_idx) in enumerate(skf.split(X, y), start=1):
        X_train, X_valid = X.iloc[train_idx], X.iloc[valid_idx]
        y_train, y_valid = y.iloc[train_idx], y.iloc[valid_idx]

        pipeline = Pipeline(steps=[
            ("preprocessor", preprocessor),
            ("model", model)
        ])

        pipeline.fit(X_train, y_train)

        valid_pred = pipeline.predict_proba(X_valid)[:, 1]
        fold_auc = roc_auc_score(y_valid, valid_pred)

        fpr, tpr, _ = roc_curve(y_valid, valid_pred)

        plt.plot(fpr, tpr, label=f"Fold {fold} AUC = {fold_auc:.5f}")

        fold_auc_rows.append({
            "fold": fold,
            "valid_auc": fold_auc
        })

    plt.plot([0, 1], [0, 1], linestyle="--", label="Random classifier")
    plt.title(f"ROC Curves per Fold — {model_name}")
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.show()

    return pd.DataFrame(fold_auc_rows)


